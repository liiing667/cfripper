{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Conditions": {
    "IsProd": {
      "Fn::Equals": [
        {
          "Ref": "Environment"
        },
        "prod"
      ]
    }
  },
  "Parameters": {
    "Environment": {
      "Type": "String",
      "Default": "dev"
    }
  },
  "Resources": {
    "ConditionalRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sts:AssumeRole",
              "Principal": {
                "AWS": {
                  "Fn::If": [
                    "IsProd",
                    "arn:aws:iam::123456789012:root",
                    "*"
                  ]
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ConditionalPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::If": [
                      "IsProd",
                      {
                        "Fn::Sub": "arn:aws:s3:::prod-bucket/*"
                      },
                      "*"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
